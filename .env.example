# Copy to .env and adjust. Never commit .env.

# Metadata database password (used by the bundled postgres service).
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Host directory for reports, temporary restores and signing keys. Must be an absolute path; it is mounted
# at the same path inside the worker (see compose.yaml).
RESTOREPROOF_HOST_DATA=/var/lib/restoreproof

# Port on 127.0.0.1 for the dashboard/API.
RESTOREPROOF_PORT=8080

# Public URL used in notification links.
RESTOREPROOF_BASE_URL=http://localhost:8080

# Conservative homelab defaults.
RESTOREPROOF_MAX_CONCURRENT_JOBS=1
# Refuse to start a restore unless this many bytes stay free (default 1 GiB).
RESTOREPROOF_MIN_FREE_BYTES=1073741824
# Bounded retries for transient infrastructure failures (repository unreachable, worker crash).
RESTOREPROOF_MAX_ATTEMPTS=2
# Sign report manifests with an Ed25519 key kept in $RESTOREPROOF_HOST_DATA/secrets.
RESTOREPROOF_SIGN_REPORTS=true
