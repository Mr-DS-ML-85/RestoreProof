{
  "id": "navidrome",
  "name": "Navidrome",
  "category": "Media",
  "summary": "Check navidrome.db (users, library).",
  "params": [],
  "backup_guidance": [
    "Back up the /data folder; the music library itself is usually backed up separately."
  ],
  "definition": {
    "apiVersion": "restoreproof.io/v1alpha1",
    "kind": "RecoveryTest",
    "metadata": {
      "name": "{{name}}"
    },
    "spec": {
      "checks": [
        {
          "type": "sqlite_integrity",
          "path": "navidrome.db",
          "tables": [
            "user",
            "media_file"
          ]
        }
      ]
    }
  },
  "format": "restoreproof-template/v1",
  "layers": [
    "data",
    "database"
  ]
}
